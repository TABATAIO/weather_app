{
  "name": "Weather Mascot App",
  "short_name": "WeatherMascot",
  "description": "AI powered weather mascot companion app",
  "version": "2.0.0",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#4f46e5",
  "background_color": "#ffffff",
  "categories": ["weather", "companion", "lifestyle"],
  "lang": "ja",
  "dir": "ltr",
  "icons": [
    {
      "src": "img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "img/icon-512.png", 
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "img/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "img/screenshot-mobile.png",
      "sizes": "360x640",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "img/screenshot-desktop.png", 
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "Check Weather",
      "url": "/?action=weather",
      "description": "Quickly check current weather",
      "icons": [
        {
          "src": "img/shortcut-weather.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Chat with Mascot",
      "url": "/?action=chat", 
      "description": "Start chatting with your mascot",
      "icons": [
        {
          "src": "img/shortcut-chat.png",
          "sizes": "96x96", 
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+weathermascot",
      "url": "/?from=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}